# Copier ce fichier en ".env" puis remplir les valeurs.
# Le fichier ".env" ne doit JAMAIS être envoyé sur GitHub.
#
# Supabase : tableau de bord > bouton « Connect » > « Session pooler ».
# Le pooler fonctionne en IPv4 ; la connexion directe (db.<ref>.supabase.co) est en IPv6 seulement.
PGHOST=aws-0-REGION.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
# Avec le pooler, l'utilisateur est suffixé par la référence du projet :
#   postgres.<ref>    (ou partage_ro.<ref> si vous créez le compte de lecture seule)
PGUSER=postgres.REFERENCE_DU_PROJET
PGPASSWORD=mot_de_passe
PGSSLMODE=require
